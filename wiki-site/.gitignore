# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# The RSS feed is generated from the posts by `pnpm wiki:feed`, which both build
# scripts run, so it is build output rather than source. Hand edits would be
# overwritten on the next build; edit the post and rebuild.
artifacts/wiki/public/feed.xml

# Local counter database from `pnpm counter:dev`. The real one lives on the
# service's volume and is never in the repository.
counter.sqlite
counter.sqlite-shm
counter.sqlite-wal

